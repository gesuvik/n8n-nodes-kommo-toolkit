{
	"name": "n8n-nodes-kommo-toolkit",
	"version": "0.3.0-beta.1",
	"description": "Extended Kommo community nodes for n8n: 68 operations, webhooks, bulk actions, and an API escape hatch",
	"keywords": [
		"n8n-community-node-package",
		"kommo",
		"n8n",
		"crm",
		"webhook"
	],
	"license": "MIT",
	"homepage": "https://github.com/gessuvik/n8n-nodes-kommo-toolkit#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gessuvik/n8n-nodes-kommo-toolkit.git"
	},
	"bugs": {
		"url": "https://github.com/gessuvik/n8n-nodes-kommo-toolkit/issues"
	},
	"author": {
		"name": "n8n-nodes-kommo-toolkit",
		"email": "noreply@users.noreply.github.com"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"engines": {
		"node": ">=22",
		"pnpm": ">=9.1"
	},
	"packageManager": "pnpm@11.21.0",
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"format": "prettier nodes credentials test docs package.json README.md CHANGELOG.md CONTRIBUTING.md --write",
		"format:check": "prettier nodes credentials test docs package.json README.md CHANGELOG.md CONTRIBUTING.md --check",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"package:check": "node --test test/package.test.js",
		"release": "n8n-node release",
		"test": "n8n-node build && node --test test/*.test.js"
	},
	"files": [
		"dist",
		"CHANGELOG.md",
		"docs"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/kommoOAuth2Api.credentials.js",
			"dist/credentials/kommoLongLivedApi.credentials.js",
			"dist/credentials/kommoWebhookSecretApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Kommo/Kommo.node.js",
			"dist/nodes/Kommo/KommoApi.node.js",
			"dist/nodes/Kommo/KommoBulk.node.js",
			"dist/nodes/Kommo/KommoTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"n8n-workflow": "2.16.0",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
